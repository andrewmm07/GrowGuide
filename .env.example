# Copy to .env.local and fill in values. Never commit .env.local.

# --- Required for the app (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Weather forecast (embedded in static/mobile builds — restrict key by HTTP referrer / app bundle in WeatherAPI dashboard)
NEXT_PUBLIC_WEATHER_API_KEY=your-weatherapi-key
# Alternate name also supported:
# NEXT_PUBLIC_WEATHERAPI_KEY=

# --- Optional: error reporting (Sentry) ---
# Create a project at https://sentry.io — leave unset to disable
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --- Server / scripts only (never expose to client) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# WEATHER_API_KEY=your-weatherapi-key

# --- Push notification digest (local scripts + Supabase Edge Function secrets) ---
# CRON_SECRET=random-long-secret-for-cron-auth
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Build flags ---
# EXPORT_STATIC=true          # Set by npm run build:mobile for Capacitor
# DIGEST_TEST_NOW=2026-06-02T22:00:00.000Z   # Override "now" when testing notification digest locally
