{
  "name": "garden-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:phone": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test lib/planting/plantTimingAliases.test.ts lib/microclimate/frostSeason.test.ts lib/perennialPlanting.test.ts lib/plantActivityCopy.test.ts lib/plantCareSchedule.test.ts lib/notificationService.test.ts lib/rollingWeatherCondition.test.ts lib/weeklyGuidanceInference.test.ts lib/weeklyGuidanceWeatherTone.test.ts",
    "test:plant-picker": "npm test",
    "build:mobile": "set EXPORT_STATIC=true&& set NEXT_PUBLIC_UI_REV=4&& next build",
    "mobile:refresh": "npm run build:mobile && npm run mobile:sync",
    "mobile:sync": "npx cap sync android",
    "mobile:android": "npx cap open android",
    "preview:blackmans-bay": "tsx scripts/preview-blackmans-bay-weekly.ts",
    "preview:blackmans-bay:2025": "tsx scripts/preview-blackmans-bay-weekly.ts --year 2025",
    "preview:matrix": "tsx scripts/preview-location-matrix.ts",
    "preview:matrix:2025": "tsx scripts/preview-location-matrix.ts --year 2025",
    "validate:preview": "tsx scripts/validate-preview.ts",
    "audit:plant-picker": "tsx scripts/audit-plant-picker-matrix.ts",
    "audit:plant-picker:matrix": "tsx scripts/audit-plant-picker-matrix.ts -- --matrix",
    "audit:plant-picker:summary": "tsx scripts/audit-plant-picker-matrix.ts -- --summary-only",
    "audit:plant-picker:detail": "tsx scripts/audit-plant-picker-matrix.ts -- --detail",
    "build:month-overviews": "tsx scripts/build-month-overviews-from-csv.ts",
    "dump:month-overviews": "tsx scripts/dump-month-overviews.ts",
    "prebuild": "npm run build:month-overviews",
    "audit:gap-crops": "tsx scripts/audit-gap-crops.ts",
    "build:notification-digest": "node scripts/build-notification-digest-bundle.mjs",
    "deploy:notification-digest": "npm run build:notification-digest && npx supabase functions deploy notification-digest",
    "digest:notifications": "tsx scripts/run-notification-digest.ts",
    "test:push": "tsx scripts/send-test-push.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.49.8",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "next": "^14.1.0",
    "next-themes": "^0.4.4",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "@sentry/react": "^9.20.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
